# Weather API Configuration
# By default, leaving this as "default" uses the built-in free Open-Meteo API (no key required).
# Whenever you want to use your own API key in the future, replace "default" with your actual key:
VITE_WEATHER_API_KEY=default

# Application Settings
VITE_APP_TITLE=SkyCast
VITE_DEFAULT_CITY=Tokyo
VITE_WEATHER_CACHE_TTL_MS=900000
